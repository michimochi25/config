# Opt-in: route Claude Code through the local caveman compression proxy.
#
# NOT applied by default. These settings only work when caveman is installed
# and its proxy is listening, so they are kept out of settings.json and must be
# turned on per machine.
#
# Enable with:   ./install.sh --with-caveman
# or by hand:    echo 'source ~/projects/dotfiles/claude/local/caveman.env' >> ~/.bashrc
#
# Verify the proxy is up before enabling:  curl -sS http://127.0.0.1:8787/healthz

export ANTHROPIC_BASE_URL="http://127.0.0.1:8787/w/claude"
export _CLAUDE_CODE_ASSUME_FIRST_PARTY_BASE_URL="1"
