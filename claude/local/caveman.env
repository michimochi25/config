# Route Claude Code through the local caveman compression proxy.
#
# Sourced from ~/.bashrc by ./install.sh on every machine. Kept out of
# settings.json because it must be conditional: see the guard below.
#
# The proxy need not be running first: the caveman SessionStart hook starts it.
# Check it's listening with:
#   curl -s -o /dev/null -w '%{http_code}\n' http://127.0.0.1:8787/
# Any HTTP code (even 404) means it's up; 000 means nothing is listening.
# (There is no health endpoint — /healthz also answers 404.)

# Only redirect when the caveman hook can actually run, because that hook is
# what starts the proxy. Otherwise nothing would listen on :8787 and every API
# call would fail, so leave Claude Code talking to the API directly instead.
# The hook's --check owns the definition of "ready" so the two never disagree.
#
# Needs `caveman` on PATH, so this must be sourced after nvm (or whatever puts
# Node's bin dir on PATH) is set up — otherwise it silently stays off.
if "${BASH_SOURCE[0]%/*}/../hooks/caveman" --check; then
  export ANTHROPIC_BASE_URL="http://127.0.0.1:8787/w/claude"
  export _CLAUDE_CODE_ASSUME_FIRST_PARTY_BASE_URL="1"
fi
