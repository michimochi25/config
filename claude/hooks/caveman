#!/usr/bin/env bash
# Guarded wrapper for the caveman native hook.
#
# settings.json wires this into every hook event. On a machine without caveman
# installed it exits 0 silently, so the entries are inert rather than erroring
# on each tool call. Resolves the CLI adapter from whatever Node the `caveman`
# shim lives under, so no Node version is pinned.
#
#   caveman            # run as a hook
#   caveman --check    # exit 0 if the hook can run (and so start the proxy), 1 if not
#
# --check is the single definition of "caveman is ready": claude/local/caveman.env
# uses it to decide whether to point Claude Code at the proxy, so the two can't
# drift apart.
set -u

mode="${1:-}"

# Missing piece: a hook must stay inert (exit 0), but --check must report it.
not_ready() { [ "$mode" = --check ] && exit 1; exit 0; }

proxy="$HOME/.caveman/bin/caveman-proxy"
[ -x "$proxy" ] || not_ready

cli="$(command -v caveman 2>/dev/null)" || not_ready
[ -n "$cli" ] || not_ready

# npm installs `caveman` as a symlink into the package; resolving it lands on
# <pkg>/dist/index.js, and the hook adapter sits beside it.
adapter="$(dirname "$(readlink -f "$cli")")/native-hook-fast.js"
[ -f "$adapter" ] || not_ready

[ "$mode" = --check ] && exit 0

exec "$proxy" native-hook claude --adapter "$adapter"
